# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://lms:lms@localhost:5432/lms

# Auth (JWT)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# Change APP_SECRET_KEY in production — used to sign JWTs

# Library policy
LIBRARY_TIMEZONE=Asia/Kolkata

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*

# Security (see .cursor/rules/security-and-hardening.md)
# SECURITY_HSTS_ENABLED=true          # Enable only behind HTTPS in production
# RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# API_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_WINDOW_SECONDS=900

# Phase 8 — agent desk (MVP.md §2.2)
# AGENT_ISSUE_ENABLED=false
# AGENT_MOCK_LLM=true

# --- LLM provider (LiteLLM) — pick one primary or set a fallback chain ---
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODEL_FAST=llama-3.1-8b-instant

# Provider API keys (set the one(s) you use)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TOGETHER_API_KEY=
# HF_TOKEN=

# Optional: try providers in order (overrides LLM_PROVIDER + LLM_FALLBACK_*)
# Per-provider model override: provider:model-id
# LLM_PROVIDERS=groq,openai
# LLM_PROVIDERS=groq:llama-3.3-70b-versatile,together:meta-llama/Meta-Llama-3-8B-Instruct-Turbo

# Legacy fallback (used when LLM_PROVIDERS is unset)
# LLM_FALLBACK_ENABLED=false
# LLM_FALLBACK_PROVIDER=together
# LLM_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct

# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=   # alias for LANGFUSE_HOST (e.g. https://us.cloud.langfuse.com)
