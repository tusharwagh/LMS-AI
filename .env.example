# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://lms:lms@localhost:5432/lms

# Auth (JWT)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# Change APP_SECRET_KEY in production — used to sign JWTs

# Library policy
LIBRARY_TIMEZONE=Asia/Kolkata

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*
