# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://lms:lms@localhost:5432/lms

# Auth (JWT)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# Change APP_SECRET_KEY in production — used to sign JWTs

# Library policy
LIBRARY_TIMEZONE=Asia/Kolkata

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*

# Security (see .cursor/rules/security-and-hardening.md)
# SECURITY_HSTS_ENABLED=true          # Enable only behind HTTPS in production
# RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# API_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_WINDOW_SECONDS=900

# Phase 8 — agent desk (MVP.md §2.2)
# AGENT_ISSUE_ENABLED=false
# AGENT_MOCK_LLM=true
# GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
