						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "• ADR-002: Orchestrator only cross-context writes"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "• ADR-006: Single TX + FOR UPDATE on holding"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "• ADR-017: Idempotency-Key header"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "• D3: JWT ADMIN/LIBRARIAN/PATRON"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "• D4: Librarian-only checkout"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "• Import-linter: no cross-BC infra imports"
								}
							]
						}
					]
				}
			},
